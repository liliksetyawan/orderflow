# Frontend env vars. All are optional — if unset, the app falls back to
# http://localhost:808X (good for local dev, useless on a deployed origin).
#
# In production (Vercel), set these in the project's "Environment Variables"
# panel to point at a publicly-reachable backend (e.g. railway / fly / render).

VITE_ORDER_BASE_URL=
VITE_PAYMENT_BASE_URL=
VITE_INVENTORY_BASE_URL=
VITE_NOTIFICATION_BASE_URL=
