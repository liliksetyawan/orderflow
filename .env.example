# Copy to .env for local dev. Each service's main.go auto-loads .env on
# boot via godotenv (best-effort, non-overwriting). In production, env
# vars come from the orchestrator and .env is absent — that's fine.

# --- Postgres (single instance, schema-per-service) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=orderflow
POSTGRES_DB=orderflow

# --- RabbitMQ ---
RABBITMQ_URL=amqp://orderflow:orderflow@localhost:5672/

# --- Redis ---
REDIS_ADDR=localhost:6379

# --- Tracing ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Service ports ---
ORDER_HTTP_PORT=8081
ORDER_GRPC_PORT=9081
PAYMENT_HTTP_PORT=8082
PAYMENT_GRPC_PORT=9082
INVENTORY_HTTP_PORT=8083
INVENTORY_GRPC_PORT=9083
NOTIFICATION_HTTP_PORT=8084

# --- Mock payment gateway tuning (payment service) ---
PAYMENT_GATEWAY_SUCCESS_RATE=0.85
